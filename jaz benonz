const progressInput = document.getElementById("progressInput");
const progressNumber = document.getElementById("progressNumber");
const progressBar = document.getElementById("progressBar");
progressInput.addEventListener("input", () => {
  const value = Number(progressInput.value);
  progressNumber.textContent = `${value}%`;
  progressBar.style.width = `${value}%`;
});

const checks = [...document.querySelectorAll(".mission-check")];
const checkCount = document.getElementById("checkCount");
function updateChecks() {
  const done = checks.filter(check => check.checked).length;
  checkCount.textContent = `${done} of ${checks.length} completed`;
}
checks.forEach(check => check.addEventListener("change", updateChecks));

const note = document.getElementById("sketchNote");
const saveMessage = document.getElementById("saveMessage");
try {
  note.value = localStorage.getItem("novaXSketchNotes") || "";
} catch (error) {
  // Storage may be unavailable in some browser preview modes.
}
document.getElementById("saveNote").addEventListener("click", () => {
  try {
    localStorage.setItem("novaXSketchNotes", note.value);
    saveMessage.textContent = "Notes saved on this device.";
  } catch (error) {
    saveMessage.textContent = "Saving is unavailable in this browser mode. Copy your notes somewhere safe.";
  }
});

const menuButton = document.getElementById("menuButton");
const nav = document.getElementById("nav");
menuButton.addEventListener("click", () => nav.classList.toggle("open"));
nav.querySelectorAll("a").forEach(link => link.addEventListener("click", () => nav.classList.remove("open")));

if ("serviceWorker" in navigator && location.protocol.startsWith("http")) {
  window.addEventListener("load", () => navigator.serviceWorker.register("./service-worker.js").catch(() => {}));
}

